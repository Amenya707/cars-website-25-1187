<!-- ================= MODULE 1 CSS TASK ================= -->

<hr>

<!-- Paragraph 1 - Inline CSS -->
<p style="color: blue; font-style: italic;">
    This is Paragraph 1 styled using Inline CSS.
</p>

<!-- Paragraph 2 - Internal CSS -->
<p class="internal-paragraph">
    This is Paragraph 2 styled using Internal CSS.
</p>

<!-- Paragraph 3 - External CSS -->
<p class="external-paragraph">
    This is Paragraph 3 styled using External CSS.
</p>

<hr>

<!-- H1 Headings -->
<h1 style="color: red;">Highlight 1</h1>
<h1 class="highlight2">Highlight 2</h1>
<h1 class="highlight3">Highlight 3</h1>

<hr>

<!-- H3 Headings -->
<h3 style="color: purple;">Building 1</h3>
<h3 class="building2">Building 2</h3>
<h3 class="building3">Building 3</h3>

.internal-paragraph {
    color: orange;
    font-weight: bold;
}

.highlight2 {
    color: green;
}

.building2 {
    color: brown;
}



.external-paragraph {
    color: purple;
    text-decoration: underline;
}

.highlight3 {
    color: darkblue;
}

.building3 {
    color: darkred;
}
