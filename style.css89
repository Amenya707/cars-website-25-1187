
        /* Paragraph 2 - Internal */
        #para2 {
            color: orange;
            font-weight: bold;
        }

        /* Highlight 2 - Internal */
        #highlight2 {
            color: green;
        }

        /* Building 2 - Internal */
        #building2 {
            color: brown;
        }
    </style>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h2>Paragraphs</h2>

    <!-- Paragraph 1 - Inline -->
    <p style="color: blue; font-style: italic;">
        Paragraph 1
    </p>

    <!-- Paragraph 2 - Internal -->
    <p id="para2">
        Paragraph 2
    </p>

    <!-- Paragraph 3 - External -->
    <p id="para3">
        Paragraph 3
    </p>


    <h2>Highlights</h2>

    <!-- Highlight 1 - Inline -->
    <h1 style="color: red;">
        Highlight 1
    </h1>

    <!-- Highlight 2 - Internal -->
    <h1 id="highlight2">
        Highlight 2
    </h1>

    <!-- Highlight 3 - External -->
    <h1 id="highlight3">
        Highlight 3
    </h1>


    <h2>Buildings</h2>

    <!-- Building 1 - Inline -->
    <h3 style="color: purple;">
        Building 1
    </h3>

    <!-- Building 2 - Internal -->
    <h3 id="building2">
        Building 2
    </h3>

    <!-- Building 3 - External -->
    <h3 id="building3">
        Building 3
    </h3>

</body>
</html>
