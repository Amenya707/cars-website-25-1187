
/* Paragraph 3 - External CSS */
#para3 {
    color: purple;
    text-decoration: underline;
}

/* Highlight 3 - External CSS */
#highlight3 {
    color: blue;
    background-color: yellow;
}

/* Building 3 - External CSS */
#building3 {
    color: darkred;
}

/* Car Website Main Styling */

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

header {
    background-color: darkblue;
    color: white;
    text-align: center;
    padding: 40px;
}

h2 {
    color: darkred;
}

section {
    background-color: #f4f4f4;
}
